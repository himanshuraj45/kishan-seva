# ============================================================
# KisanSeva — Python ML Service Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is already in .gitignore
# ============================================================

# ─── AI / LLM (Groq — Agent Orchestration) ───────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key

# ─── AI Vision (Google Gemini — Disease Detection Vision) ────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Vector Database / Embeddings ────────────────────────────
# Used for KnowledgeBase RAG agent
# Get key at: https://huggingface.co/settings/tokens (optional)
HUGGINGFACE_TOKEN=your_hf_token

# ─── Error Tracking (Sentry — optional) ──────────────────────
# Leave blank to disable Sentry monitoring
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ─── Server Config ───────────────────────────────────────────
# Port the uvicorn server listens on
PORT=8000
HOST=0.0.0.0

# ─── CORS — Allowed frontend origins ─────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://kisanseva-ks.vercel.app

# ─── Model Paths (auto-resolved, no changes needed) ──────────
# MODEL_PATH=./models/disease_model.onnx
# LABELS_PATH=./models/labels.json
